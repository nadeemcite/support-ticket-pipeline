# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Provider -------------------------------------------------------------
# Leave unset to auto-detect: OPENAI_API_KEY set -> openai; else OLLAMA_* set -> ollama; else stub (offline, no keys).
# Set it only to force one: openai | ollama | stub
# LLM_PROVIDER=
# Model overrides. Defaults: gpt-4o-mini (openai, or OPENAI_MODEL) / glm-5.2 (ollama). A ":cloud" suffix is accepted and stripped.
# OPENAI_MODEL=gpt-4o-mini
# LLM_MODEL=glm-5.2

# --- Credentials ----------------------------------------------------------
# Required when LLM_PROVIDER=ollama. Base URL is OpenAI-compatible and ends in /v1.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
# Required for embedding retrieval (the default unless LLM_PROVIDER=stub), LLM_PROVIDER=openai,
# evals (gpt-6.1-sol) and scripts/generate_banner.py.
OPENAI_API_KEY=

# --- Retrieval ------------------------------------------------------------
# embedding (OpenAI, default) | tfidf (offline; the default when LLM_PROVIDER=stub)
# RETRIEVER=embedding
EMBEDDING_MODEL=text-embedding-3-small
# Fast dev model
LLM_FAST_MODEL=glm-5.3-flash

# --- Tuning (optional; values shown are the defaults) ----------------------
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_S=60
RETRIEVAL_TOP_K=3
# Unset = per-retriever default (embedding 0.25, tfidf 0.07); the scales differ.
# RETRIEVAL_MIN_SCORE=
MAX_TICKET_CHARS=4000
MAX_DRAFT_CHARS=1500

# Salt for the PII hashes in normalised_tickets.json. Leave unset to keep reruns byte-identical.
# PII_HASH_SALT=

# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Provider -------------------------------------------------------------
# ollama (default) | openai | stub (offline, deterministic, no keys needed)
LLM_PROVIDER=ollama
# glm-5.2 (ollama) / gpt-6.1-sol (openai). A ":cloud" suffix is accepted and stripped.
LLM_MODEL=glm-5.2

# --- Credentials ----------------------------------------------------------
# Required when LLM_PROVIDER=ollama. Base URL is OpenAI-compatible and ends in /v1.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
# Required when LLM_PROVIDER=openai, for evals (gpt-6.1-sol) and for scripts/generate_banner.py.
OPENAI_API_KEY=

# --- Tuning (optional; values shown are the defaults) ----------------------
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_S=60
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.05
MAX_TICKET_CHARS=4000
MAX_DRAFT_CHARS=1500

# Salt for the PII hashes in normalised_tickets.json. Leave unset to keep reruns byte-identical.
# PII_HASH_SALT=

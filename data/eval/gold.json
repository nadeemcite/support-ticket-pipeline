{
  "version": 1,
  "description": "Gold expectations for the eval set. For every label field, the value is a list of ACCEPTABLE values; the first element is the PREFERRED value. Scoring: strict accuracy = output == preferred; lenient accuracy = output in list.",
  "inputs": {
    "tickets": "data/eval/tickets.json",
    "kb": "data/eval/kb_articles.json"
  },
  "field_semantics": {
    "relevant_articles": "Articles that SHOULD appear in the top 3 (recall@3 / MRR). Empty list = no article is relevant (retrieval should return []).",
    "issue_type | urgency | resolution_action | escalate | target_queue | requires_refund_caution | customer_sensitive": "Acceptable values, preferred first.",
    "must_cite_any": "Draft citations must include at least one of these IDs (ignored when empty).",
    "draft_must_include_any": "At least one substring (case-insensitive) must appear in the draft. Only set for English tickets; non-English drafts are judged by the LLM-as-judge rubric.",
    "draft_must_not_include": "No substring may appear (case-insensitive). Used for PII echo, secret echo and unsupported promises.",
    "pii_expected": "PII/secret types the deterministic PII detector must find in the ticket: email, phone, card_number, iban, credential.",
    "tags": "Free-form slicing tags for eval reports."
  },
